plt.tight_layout()\n","    plt.savefig(outpath, dpi=200)\n","    plt.close()\n","    print(f\"Saved: {outpath}\")\n","\n","def plot_rmsf_two_chain(pathA, pathB, title, outpath, single_file=None):\n","    plt.figure()\n","    if single_file:\n","        x, ys = read_xvg(single_file)\n","        plt.plot(x, ys[0], color='blue', linewidth=1.5, label='Chain A')\n","        if len(ys) > 1:\n","            plt.plot(x, ys[1], color='red', linewidth=1.5, linestyle='--', label='Chain B')\n","    else:\n","        xA, yA = read_xvg(pathA)\n","        xB, yB = read_xvg(pathB)\n","        plt.plot(xA, yA[0], color='blue', linewidth=1.5, label='Chain A')\n","        plt.plot(xB, yB[0], color='red', linewidth=1.5, linestyle='--', label='Chain B')\n","    plt.title(title)\n","    plt.xlabel('Residue')\n","    plt.ylabel('RMSF (nm)')\n","    plt.legend()\n","    plt.tight_layout()\n","    plt.savefig(outpath, dpi=200)\n","    plt.close()\n","    print(f\"Saved: {outpath}\")\n","\n","def plot_rmsf_4chain(pathA_200, pathB_200, pathA_500, pathB_500, title, outpath):\n","    xA1, yA1 = read_xvg(pathA_200); xB1, yB1 = read_xvg(pathB_200)\n","    xA2, yA2 = read_xvg(pathA_500); xB2, yB2 = read_xvg(pathB_500)\n","    plt.figure()\n","    plt.plot(xA1, yA1[0], color='lightblue', linewidth=1.5, label='200ps (Chain A)')\n","    plt.plot(xB1, yB1[0], color='lightblue', linewidth=1.5, linestyle='--', label='200ps (Chain B)')\n","    plt.plot(xA2, yA2[0], color='red', linewidth=1.5, label='500ps (Chain A)')\n","    plt.plot(xB2, yB2[0], color='red', linewidth=1.5, linestyle='--', label='500ps (Chain B)')\n","    plt.title(title)\n","    plt.xlabel('Residue')\n","    plt.ylabel('RMSF (nm)')\n","    plt.legend()\n","    plt.tight_layout()\n","    plt.savefig(outpath, dpi=200)\n","    plt.close()\n","    print(f\"Saved: {outpath}\")\n","\n","# ============ 300K / 200ps ============\n","d = os.path.join(OUT, \"300K_200ps\")\n","plot_single(f\"{LEG}/rmsd.xvg\", \"RMSD of Legumin at 300K (200ps)\", \