         data.append([float(p) for p in line.split()])\n","    arr = np.array(data)\n","    return arr[:, 0], [arr[:, i] for i in range(1, arr.shape[1])]\n","\n","def plot_single(path, title, xlabel, ylabel, outpath, color='#2563eb'):\n","    if not os.path.exists(path):\n","        print(f\"MISSING: {path}\")\n","        return\n","    x, ys = read_xvg(path)\n","    plt.figure(figsize=(7, 4.5))\n","    plt.plot(x, ys[0], color=color, linewidth=1.2)\n","    plt.title(title, fontsize=13, fontweight='bold')\n","    plt.xlabel(xlabel); plt.ylabel(ylabel)\n","    plt.grid(alpha=0.3); plt.tight_layout()\n","    plt.savefig(outpath, dpi=200); plt.close()\n","    print(f\"Saved: {outpath}\")\n","\n","def plot_rmsf_two_chain(pathA, pathB, title, outpath, single_file=None):\n","    plt.figure(figsize=(7, 4.5))\n","    if single_file:\n","        x, ys = read_xvg(single_file)\n","        plt.plot(x, ys[0], color='red', linewidth=1.2, label='Chain A')\n","        if len(ys) > 1:\n","            plt.plot(x, ys[1], color='blue', linewidth=1.2, label='Chain B')\n","    else:\n","        xA, yA = read_xvg(pathA); xB, yB = read_xvg(pathB)\n","        plt.plot(xA, yA[0], color='red', linewidth=1.2, label='Chain A')\n","        plt.plot(xB, yB[0], color='blue', linewidth=1.2, label='Chain B')\n","    plt.title(title, fontsize=13, fontweight='bold')\n","    plt.xlabel('Residue'); plt.ylabel('RMSF (nm)')\n","    plt.legend(); plt.grid(alpha=0.3); plt.tight_layout()\n","    plt.savefig(outpath, dpi=200); plt.close()\n","    print(f\"Saved: {outpath}\")\n","\n","def plot_rmsf_4chain(pathA_200, pathB_200, pathA_500, pathB_500, title, outpath):\n","    plt.figure(figsize=(8, 5))\n","    xA1, yA1 = read_xvg(pathA_200); xB1, yB1 = read_xvg(pathB_200)\n","    xA2, yA2 = read_xvg(pathA_500); xB2, yB2 = read_xvg(pathB_500)\n","    plt.plot(xA1, yA1[0], color='#dc2626', linewidth=1.3, label='Chain A (200ps)')\n","    plt.plot(xB1, yB1[0], color='#2563eb', linewidth=1.3, label='Chain B (200ps)')\